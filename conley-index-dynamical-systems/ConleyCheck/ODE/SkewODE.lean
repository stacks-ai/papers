import ConleyCheck.ODE.Flow
import ConleyCheck.Conley.Slab

/-!
# Skew products generated by a time-dependent field

For a bounded, globally Lipschitz fiber field `F(x, τ)` on `E × ℝ` and a bounded, globally Lipschitz
base field `g` with `g(±1) = 0` and `g > 0` on `(-1, 1)`, the autonomous field `(F(x, τ), g(τ))`
has a global flow, and its restriction to `E × [-1, 1]` is a skew product `Φ` over the flow `θ` of
`τ' = g(τ)`, for which `τ` is a height function. This is the system `eq:slab`.

* `SkewODE.ofSmooth`: the data from a `C¹` field `A(x, s)` with compact support, evaluated at
  `s = clamp τ`, and a `g` that is Lipschitz on `[-1, 1]`, extended by constants.
* `SkewODE.hasDerivAt_Φ_fst`, `SkewODE.hasDerivAt_θ`: the two components solve the system.
-/

open Set Filter Topology Metric Function
open scoped NNReal

namespace ConleyCheck.ODE

open ConleyCheck.Conley

/-- A real flow preserves the order of the line. -/
theorem realFlow_mono (ϕ : Flow ℝ ℝ) {x y : ℝ} (h : x ≤ y) (t : ℝ) : ϕ t x ≤ ϕ t y := by
  by_contra hlt
  push Not at hlt
  have hc : Continuous fun s => ϕ s y - ϕ s x :=
    (ϕ.continuous continuous_id continuous_const).sub (ϕ.continuous continuous_id continuous_const)
  have h0 : (0 : ℝ) ∈ uIcc (ϕ 0 y - ϕ 0 x) (ϕ t y - ϕ t x) := by
    rw [Flow.map_zero_apply, Flow.map_zero_apply]
    exact mem_uIcc.2 (Or.inr ⟨by linarith, by linarith⟩)
  obtain ⟨s, -, hs⟩ := intermediate_value_uIcc hc.continuousOn h0
  have heq : ϕ s y = ϕ s x := by simp only at hs; linarith
  have := congrArg (ϕ (-s)) heq
  rw [← Flow.map_add, ← Flow.map_add, neg_add_cancel, Flow.map_zero_apply,
    Flow.map_zero_apply] at this
  rw [this] at hlt
  exact lt_irrefl _ hlt

/-! ## The retraction onto `[-1, 1]` -/

/-- The retraction of `ℝ` onto `[-1, 1]`. -/
noncomputable def clamp (τ : ℝ) : ℝ := (projIcc (-1) 1 (by norm_num) τ : ℝ)

theorem clamp_of_mem {τ : ℝ} (h : τ ∈ Icc (-1 : ℝ) 1) : clamp τ = τ := by
  simp [clamp, projIcc_of_mem _ h]

theorem clamp_mem (τ : ℝ) : clamp τ ∈ Icc (-1 : ℝ) 1 := (projIcc (-1) 1 (by norm_num) τ).2

/-- A function that is Lipschitz on `[-1, 1]`, extended by constants. -/
theorem lipschitzWith_comp_clamp {g : ℝ → ℝ} {K : ℝ≥0} (hg : LipschitzOnWith K g (Icc (-1) 1)) :
    LipschitzWith K (g ∘ clamp) := by
  have h := hg.to_restrict.comp (LipschitzWith.projIcc (a := -1) (b := 1) (by norm_num))
  rw [mul_one] at h
  exact h

theorem lipschitzWith_clamp : LipschitzWith 1 clamp :=
  lipschitzWith_comp_clamp (g := id) LipschitzWith.id.lipschitzOnWith

theorem continuous_clamp : Continuous clamp := lipschitzWith_clamp.continuous

theorem abs_comp_clamp_le {g : ℝ → ℝ} {K : ℝ≥0} (hg : LipschitzOnWith K g (Icc (-1) 1))
    (h1 : g 1 = 0) (τ : ℝ) : |g (clamp τ)| ≤ 2 * K := by
  have hd := hg.dist_le_mul _ (clamp_mem τ) 1 (by norm_num)
  rw [Real.dist_eq, Real.dist_eq, h1, sub_zero] at hd
  have : |clamp τ - 1| ≤ 2 := by
    rw [abs_le]; constructor <;> linarith [(clamp_mem τ).1, (clamp_mem τ).2]
  have hK : (K : ℝ) * |clamp τ - 1| ≤ K * 2 := mul_le_mul_of_nonneg_left this K.2
  linarith

/-! ## The data -/

variable (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- A fiber field `F` and a base field `g` on `ℝ`, both bounded and globally Lipschitz, with
`g(±1) = 0` and `g > 0` on `(-1, 1)`. -/
structure SkewODE where
  F : E × ℝ → E
  g : ℝ → ℝ
  KF : ℝ≥0
  LF : ℝ≥0
  Kg : ℝ≥0
  Lg : ℝ≥0
  lipF : LipschitzWith KF F
  bddF : ∀ p, ‖F p‖ ≤ LF
  lipg : LipschitzWith Kg g
  bddg : ∀ τ, ‖g τ‖ ≤ Lg
  g_one : g 1 = 0
  g_neg_one : g (-1) = 0
  g_pos : ∀ τ ∈ Ioo (-1 : ℝ) 1, 0 < g τ

variable {E}

namespace SkewODE

/-- The data from a `C¹` fiber field `A(x, s)` with compact support, evaluated at `s = clamp τ`,
and a base field that is Lipschitz on `[-1, 1]`, extended by constants. -/
noncomputable def ofSmooth [FiniteDimensional ℝ E] (A : E × ℝ → E) (hA : ContDiff ℝ 1 A)
    (hAs : HasCompactSupport A) (g : ℝ → ℝ) (Kg : ℝ≥0) (hg : LipschitzOnWith Kg g (Icc (-1) 1))
    (g1 : g 1 = 0) (gm1 : g (-1) = 0) (gpos : ∀ τ ∈ Ioo (-1 : ℝ) 1, 0 < g τ) : SkewODE E where
  F p := A (p.1, clamp p.2)
  g := g ∘ clamp
  KF := max 1 1 * (ContDiff.lipschitzWith_of_hasCompactSupport hAs hA one_ne_zero).choose
  LF := ⟨max (hAs.exists_bound_of_continuous hA.continuous).choose 0, le_max_right _ _⟩
  Kg := Kg
  Lg := ⟨2 * Kg, by positivity⟩
  lipF := by
    have hin : LipschitzWith (max 1 1) fun p : E × ℝ => (p.1, clamp p.2) :=
      LipschitzWith.prod_fst.prodMk (lipschitzWith_clamp.comp LipschitzWith.prod_snd |>.weaken
        (by simp))
    rw [mul_comm]
    exact (ContDiff.lipschitzWith_of_hasCompactSupport hAs hA one_ne_zero).choose_spec.comp hin
  bddF p := ((hAs.exists_bound_of_continuous hA.continuous).choose_spec _).trans (le_max_left _ _)
  lipg := lipschitzWith_comp_clamp hg
  bddg τ := by
    rw [Real.norm_eq_abs]
    exact abs_comp_clamp_le hg g1 τ
  g_one := by simp [clamp_of_mem (show (1 : ℝ) ∈ Icc (-1 : ℝ) 1 by norm_num), g1]
  g_neg_one := by simp [clamp_of_mem (show (-1 : ℝ) ∈ Icc (-1 : ℝ) 1 by norm_num), gm1]
  g_pos τ hτ := by
    simp only [Function.comp, clamp_of_mem (Ioo_subset_Icc_self hτ)]
    exact gpos τ hτ

variable [CompleteSpace E] (P : SkewODE E)

/-- The autonomous field `(F(x, τ), g(τ))` on `E × ℝ`. -/
def V (p : E × ℝ) : E × ℝ := (P.F p, P.g p.2)

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem exists_lipschitz_V : ∃ K : ℝ≥0, LipschitzWith K P.V :=
  ⟨_, P.lipF.prodMk (P.lipg.comp LipschitzWith.prod_snd)⟩

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem exists_bound_V : ∃ L : ℝ≥0, ∀ p, ‖P.V p‖ ≤ L :=
  ⟨max P.LF P.Lg, fun p => norm_prod_le_iff.2
    ⟨(P.bddF p).trans (le_max_left _ _), (P.bddg p.2).trans (le_max_right _ _)⟩⟩

/-- The flow of the autonomous field on `E × ℝ`. -/
noncomputable def Ψ : Flow ℝ (E × ℝ) :=
  flowOf P.exists_lipschitz_V.choose_spec P.exists_bound_V.choose_spec

theorem hasDerivAt_Ψ (p : E × ℝ) (t : ℝ) : HasDerivAt (fun s => P.Ψ s p) (P.V (P.Ψ t p)) t :=
  hasDerivAt_flowOf _ _ p t

/-- The flow of `τ' = g(τ)` on `ℝ`. -/
noncomputable def β : Flow ℝ ℝ := flowOf P.lipg P.bddg

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem hasDerivAt_β (τ t : ℝ) : HasDerivAt (fun s => P.β s τ) (P.g (P.β t τ)) t :=
  hasDerivAt_flowOf _ _ τ t

theorem Ψ_snd (t : ℝ) (p : E × ℝ) : (P.Ψ t p).2 = P.β t p.2 := by
  have hγ : IsSol P.g fun s => (P.Ψ s p).2 := fun s => by
    have h := hasFDerivAt_snd.comp_hasDerivAt s (P.hasDerivAt_Ψ p s)
    exact h
  have := flowOf_eq_of_isSol P.lipg P.bddg hγ 0 t
  rw [add_zero, Flow.map_zero_apply] at this
  exact this.symm

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem β_one (t : ℝ) : P.β t 1 = 1 := by
  have hγ : IsSol P.g fun _ => (1 : ℝ) := fun s => by
    simpa [P.g_one] using hasDerivAt_const s (1 : ℝ)
  exact flowOf_eq_of_isSol P.lipg P.bddg hγ 0 t

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem β_neg_one (t : ℝ) : P.β t (-1) = -1 := by
  have hγ : IsSol P.g fun _ => (-1 : ℝ) := fun s => by
    simpa [P.g_neg_one] using hasDerivAt_const s (-1 : ℝ)
  exact flowOf_eq_of_isSol P.lipg P.bddg hγ 0 t

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem β_mem {τ : ℝ} (h : τ ∈ Icc (-1 : ℝ) 1) (t : ℝ) : P.β t τ ∈ Icc (-1 : ℝ) 1 :=
  ⟨P.β_neg_one t ▸ realFlow_mono _ h.1 t, P.β_one t ▸ realFlow_mono _ h.2 t⟩

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem β_mem_Ioo {τ : ℝ} (h : τ ∈ Ioo (-1 : ℝ) 1) (t : ℝ) : P.β t τ ∈ Ioo (-1 : ℝ) 1 := by
  have hm := P.β_mem (Ioo_subset_Icc_self h) t
  have back : ∀ c, P.β (-t) c = c → P.β t τ = c → τ = c := fun c hc he => by
    rw [← hc, ← he, ← Flow.map_add, neg_add_cancel, Flow.map_zero_apply]
  refine ⟨lt_of_le_of_ne hm.1 fun he => ?_, lt_of_le_of_ne hm.2 fun he => ?_⟩
  · exact h.1.ne (back _ (P.β_neg_one _) he.symm).symm
  · exact h.2.ne (back _ (P.β_one _) he)

/-- The base flow `θ` of `τ' = g(τ)` on `[-1, 1]`. -/
noncomputable def θ : Flow ℝ Tau where
  toFun t b := ⟨P.β t b, P.β_mem b.2 t⟩
  cont' := (P.β.continuous continuous_fst (continuous_subtype_val.comp continuous_snd)).subtype_mk _
  map_add' t s b := Subtype.ext (P.β.map_add t s b)
  map_zero' b := Subtype.ext (P.β.map_zero_apply b)

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem θ_apply (t : ℝ) (b : Tau) : (P.θ t b : ℝ) = P.β t b := rfl

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem hasDerivAt_θ (b : Tau) (t : ℝ) :
    HasDerivAt (fun s => (P.θ s b : ℝ)) (P.g (P.θ t b)) t :=
  P.hasDerivAt_β b t

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem isHeight_θ : IsHeight P.θ (fun b => (b : ℝ)) where
  continuous := continuous_subtype_val
  mem b := b.2
  fix b hb t := by
    show P.β t b = b
    rcases hb with h | h <;> rw [h]
    · exact P.β_one t
    · exact P.β_neg_one t
  strict b h1 h2 t ht := by
    show (b : ℝ) < P.β t b
    have hmono : StrictMono fun s => P.β s b :=
      strictMono_of_hasDerivAt_pos (fun s => P.hasDerivAt_β b s) fun s =>
        P.g_pos _ (P.β_mem_Ioo ⟨h1, h2⟩ s)
    have := hmono ht
    simpa using this

/-- The skew-product flow on `E × [-1, 1]`. -/
noncomputable def Φ : Flow ℝ (E × Tau) where
  toFun t p := ((P.Ψ t (p.1, (p.2 : ℝ))).1, P.θ t p.2)
  cont' := (continuous_fst.comp (P.Ψ.continuous continuous_fst
    ((continuous_fst.comp continuous_snd).prodMk
      (continuous_subtype_val.comp (continuous_snd.comp continuous_snd))))).prodMk
    (P.θ.continuous continuous_fst (continuous_snd.comp continuous_snd))
  map_add' t s p := by
    have e : P.Ψ s (p.1, (p.2 : ℝ)) = ((P.Ψ s (p.1, (p.2 : ℝ))).1, ((P.θ s p.2 : Tau) : ℝ)) :=
      Prod.ext rfl (P.Ψ_snd s _)
    show ((P.Ψ (t + s) (p.1, (p.2 : ℝ))).1, P.θ (t + s) p.2) =
      ((P.Ψ t ((P.Ψ s (p.1, (p.2 : ℝ))).1, ((P.θ s p.2 : Tau) : ℝ))).1, P.θ t (P.θ s p.2))
    rw [← e, ← Flow.map_add, ← Flow.map_add]
  map_zero' p := by
    show ((P.Ψ 0 (p.1, (p.2 : ℝ))).1, P.θ 0 p.2) = p
    rw [Flow.map_zero_apply, Flow.map_zero_apply]

theorem Φ_snd (t : ℝ) (p : E × Tau) : (P.Φ t p).2 = P.θ t p.2 := rfl

theorem isSkew_Φ : IsSkew P.Φ P.θ := fun _ _ => rfl

/-- The fiber component solves `x' = F(x, τ)`. -/
theorem hasDerivAt_Φ_fst (p : E × Tau) (t : ℝ) :
    HasDerivAt (fun s => (P.Φ s p).1) (P.F ((P.Φ t p).1, (P.θ t p.2 : ℝ))) t := by
  have h := hasFDerivAt_fst.comp_hasDerivAt t (P.hasDerivAt_Ψ (p.1, (p.2 : ℝ)) t)
  have e : (P.V (P.Ψ t (p.1, (p.2 : ℝ)))).1 = P.F ((P.Φ t p).1, (P.θ t p.2 : ℝ)) := by
    simp only [V]
    congr 1
    exact Prod.ext rfl (P.Ψ_snd t _)
  exact e ▸ h

theorem continuous_Φ_fst (p : E × Tau) : Continuous fun s => (P.Φ s p).1 :=
  continuous_fst.comp (P.Φ.continuous continuous_id continuous_const)

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem continuous_θ (b : Tau) : Continuous fun s => (P.θ s b : ℝ) :=
  continuous_subtype_val.comp (P.θ.continuous continuous_id continuous_const)

end SkewODE

end ConleyCheck.ODE
